{
  "manifest_version": 3,
  "name": "Fatfox Lite 新标签页",
  "version": "0.1.0",
  "description": "极简新标签页：时钟、农历、搜索、图标、Dock、便签。无追踪、无 AI、不联网。",
  "author": "iJiangli",
  "homepage_url": "https://github.com/iJiangli/fatfox-lite",
  "permissions": ["storage", "favicon"],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "icons": {
    "16": "assets/icons/16.png",
    "32": "assets/icons/32.png",
    "48": "assets/icons/48.png",
    "128": "assets/icons/128.png"
  }
}
